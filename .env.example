# 단축어 Authorization 헤더에 넣을 토큰. 생성: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
OBA_UPLOAD_TOKEN=change-me
OBA_DATA_DIR=data
OBA_PORT=8000
OBA_MAX_UPLOAD_MB=100
OBA_DEFAULT_CALLER=엄마

# 외부 https 주소 (vooy 연결 주소·대시보드 링크를 만들 때 사용)
OBA_PUBLIC_URL=http://localhost:8000

# 통신사(SKT 에이닷) 통화 종료 웹훅 (/v1/telco/call-ended)
OBA_TELCO_TOKEN=change-me-too
# 설정하면 X-Telco-Timestamp + X-Telco-Signature(HMAC-SHA256)도 요구
OBA_TELCO_SIGNING_SECRET=

# 분석 엔진: 키가 있는 것부터 SKT A.X → OpenAI → Claude 순으로 쓰고, 실패하면 다음 엔진, 모두 없으면 규칙 기반
OBA_AX_API_KEY=
# OBA_AX_BASE_URL=https://agent-os-biz.adot.ai/oba/v1
# OBA_AX_MODEL=skt/a.ll/A.X-K2-ADOT
OPENAI_API_KEY=
# OBA_OPENAI_BASE_URL=https://api.openai.com/v1
# OBA_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# OBA_CLAUDE_MODEL=claude-sonnet-5-5

# 녹음 파일만 올 때 음성 인식 (OpenAI 호환 /audio/transcriptions, 없으면 OPENAI_API_KEY)
OBA_STT_API_KEY=
# OBA_STT_BASE_URL=https://api.openai.com/v1
# OBA_STT_MODEL=whisper-1

# vooy 연결 (원격 MCP). 공용(가입용) 주소는 {OBA_PUBLIC_URL}/mcp/{OBA_MCP_TOKEN}
OBA_MCP_TOKEN=change-me-random

# 체험 서버 기능 (체험 계정, demo_parent_call 도구, 통화 결과 조회). 끄려면 0
OBA_DEMO_MODE=1

# vooy 웹훅 기본값 — 단일 계정 운영용. 보통은 대시보드에서 계정별로 설정
OBA_VOOY_PUSH_URL=
OBA_VOOY_PUSH_TOKEN=
OBA_VOOY_USER_ID=
OBA_VOOY_SIGNING_SECRET=
