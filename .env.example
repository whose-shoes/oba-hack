# 단축어 Authorization 헤더에 넣을 토큰. 생성: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
OBA_UPLOAD_TOKEN=change-me
OBA_DATA_DIR=data
OBA_PORT=8000
OBA_MAX_UPLOAD_MB=100
OBA_DEFAULT_CALLER=엄마

# 통신사(SKT 에이닷) 통화 종료 웹훅 인증 토큰 (/v1/telco/call-ended)
OBA_TELCO_TOKEN=change-me-too

# 분석 엔진 (있는 것부터 사용: A.X K2 → Claude → 규칙 기반)
OBA_AX_API_KEY=
# OBA_AX_BASE_URL=https://agent-os-biz.adot.ai/oba/v1
# OBA_AX_MODEL=skt/a.ll/A.X-K2-ADOT
ANTHROPIC_API_KEY=
# OBA_CLAUDE_MODEL=claude-sonnet-5-5

# 녹음 파일만 올 때 음성 인식 (OpenAI 호환 /audio/transcriptions)
OBA_STT_API_KEY=
# OBA_STT_BASE_URL=https://api.openai.com/v1
# OBA_STT_MODEL=whisper-1

# vooy 연결 (원격 MCP). vooy에는 {OBA_PUBLIC_URL}/mcp/{OBA_MCP_TOKEN} 주소를 넣는다
OBA_MCP_TOKEN=change-me-random
OBA_PUBLIC_URL=https://xxxx.ngrok-free.app
# vooy 발송 창구가 확인되면 채운다 (없으면 정리본을 보낼 함에 쌓고 get_new_parent_requests로 가져감)
OBA_VOOY_PUSH_URL=
OBA_VOOY_PUSH_TOKEN=
OBA_VOOY_USER_ID=
